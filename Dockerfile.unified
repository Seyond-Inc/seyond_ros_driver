# syntax=docker/dockerfile:1
# Base: the same public image as before (ros:jazzy-perception-noble), now pinned by the digest of
# its multi-arch index as found on Docker Hub on 2026-11-21 (tag last updated 2026-11-20 06:17 UTC).
# A build from the bare tag on that day used exactly this image. Move all three Dockerfiles together.

# Stage 1: Build the source-based driver
FROM --platform=linux/amd64 ros:jazzy-perception-noble@sha256:233408de3a53d864d7f5e1c8c6ff7948d126162f22221c8f0a8785ab7b03095b AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=jazzy

WORKDIR /opt/metrolla/seyond
COPY . .

RUN apt-get update && apt-get install -y \
    git \
    iproute2 \
    libyaml-cpp-dev \
    python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

# Initialize submodules (in case they weren't populated on the host)
RUN git submodule update --init --recursive || true

# Build the driver from source
RUN bash -c "source /opt/ros/jazzy/setup.bash && ./build.bash"

# Stage 2: Final unified image
FROM --platform=linux/amd64 ros:jazzy-perception-noble@sha256:233408de3a53d864d7f5e1c8c6ff7948d126162f22221c8f0a8785ab7b03095b

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=jazzy

WORKDIR /opt/metrolla/seyond

# Copy the source-built workspace from the builder stage
COPY --from=builder /opt/metrolla/seyond/install/ /opt/metrolla/seyond/install/

# Copy and install the deb package (Hummingbird driver)
COPY seyond-ros2-jazzy-3.103.10-rv3.6.7-x86.deb /tmp/seyond-driver.deb

RUN apt-get update && \
    apt-get install -y /tmp/seyond-driver.deb \
    iproute2 \
    ros-jazzy-rviz2 \
    libyaml-cpp-dev \
    && rm -f /tmp/seyond-driver.deb \
    && rm -rf /var/lib/apt/lists/*

# Copy config, launch files, and entrypoint
COPY src/seyond_lidar_ros/config/config.yaml config/config.yaml
COPY src/seyond_lidar_ros/config/two-config.yaml config/two-config.yaml
COPY src/seyond_lidar_ros/launch/ launch/
COPY entrypoint-unified.sh /usr/local/bin/entrypoint-unified.sh
RUN chmod +x /usr/local/bin/entrypoint-unified.sh

ENTRYPOINT ["entrypoint-unified.sh"]
CMD ["bash", "-c", "sleep 30; ros2 launch seyond start_with_config.py"]