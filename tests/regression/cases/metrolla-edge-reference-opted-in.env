# What metrolla-edge's reference Robin-W template would pass after opting in (sensor id east,
# data port 8010, the topic and frame the stack reads).
METROLLA_DRIVER_CONTRACT=1
SENSOR_ID=east
LIDAR_MODEL=seyond-robin-w
SENSOR_IP=172.168.1.10
DATA_PORT=8010
FRAME_ID=seyond
POINTCLOUD_TOPIC=/iv_points
TIME_MODE=ptp
ROS_LOCALHOST_ONLY=1
USE_MACADDRESS_NS=0
ROS_LOG_DIR=/var/log/ros2
HOME=/var/log/ros2
TZ=UTC
