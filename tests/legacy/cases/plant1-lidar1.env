# balena-fleets plant1/docker-compose-ros2.yml met_lidar_driver (line 154 ff.): the first of
# two drivers, DUAL_LIDAR set (compose value True), its own command line.
FASTRTPS_DEFAULT_PROFILES_FILE=/etc/metrolla/fastdds.xml
ROS_LOCALHOST_ONLY=1
USE_MACADDRESS_NS=0
DUAL_LIDAR=True
argv: ["/bin/bash", "-lc", "sleep 10; source /opt/ros/jazzy/setup.bash && ros2 launch seyond start.py lidar_ip:=172.168.1.10 udp_port:=8010 frame_id:=seyond frame_topic:=/iv_points"]
