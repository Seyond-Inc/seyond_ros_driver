# balena-fleets plant1/docker-compose-ros2.yml met_lidar_driver11 (line 181 ff.).
FASTRTPS_DEFAULT_PROFILES_FILE=/etc/metrolla/fastdds.xml
ROS_LOCALHOST_ONLY=1
USE_MACADDRESS_NS=0
DUAL_LIDAR=True
argv: ["/bin/bash", "-lc", "sleep 10; source /opt/ros/jazzy/setup.bash && ros2 launch seyond start.py lidar_ip:=172.168.1.11 udp_port:=8011 frame_id:=seyond2 frame_topic:=/iv_points2"]
