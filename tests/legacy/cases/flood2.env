# balena-fleets flood2/docker-compose-ros2.yml met_lidar_driver (line 188 ff., commit 1577610),
# DRIVER_VERSION=v1.0.8-packets.
FASTRTPS_DEFAULT_PROFILES_FILE=/etc/metrolla/fastdds.xml
ROS_LOCALHOST_ONLY=1
USE_MACADDRESS_NS=0
ROS_LOG_DIR=/var/log/ros2
argv: ["/bin/bash", "-lc", "sleep 10; source /opt/ros/jazzy/setup.bash && ros2 launch seyond start.py continue_live:=True"]
