# syntax=docker/dockerfile:1
# Base: the same public image as before (ros:jazzy-perception-noble), now pinned by the digest of
# its multi-arch index as found on Docker Hub on 2026-11-21 (tag last updated 2026-11-20 06:17 UTC).
# A build from the bare tag on that day used exactly this image. Move all three Dockerfiles together.
FROM --platform=linux/amd64 ros:jazzy-perception-noble@sha256:233408de3a53d864d7f5e1c8c6ff7948d126162f22221c8f0a8785ab7b03095b

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=jazzy

WORKDIR /opt/metrolla/seyond

# Copy the pre-built deb package
COPY seyond-ros2-jazzy-3.103.10-rv3.6.7-x86.deb /tmp/seyond-driver.deb

# Install the deb package and its dependencies
RUN apt-get update && \
    apt-get install -y /tmp/seyond-driver.deb \
    iproute2 \
    ros-jazzy-rviz2 \
    && rm -f /tmp/seyond-driver.deb \
    && rm -rf /var/lib/apt/lists/*

# Copy config, launch files, and entrypoint
COPY src/seyond_lidar_ros/config/config.yaml config/config.yaml
COPY src/seyond_lidar_ros/launch/ launch/
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["entrypoint.sh"]
CMD ["ros2", "launch", "seyond", "start_with_config.py"]
